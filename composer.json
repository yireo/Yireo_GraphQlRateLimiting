{
  "name": "yireo/magento2-graph-ql-rate-limiting",
  "license": "OSL-3.0",
  "type": "magento2-module",
  "version": "0.0.6",
  "homepage": "https://github.com/yireo/Yireo_GraphQlRateLimiting",
  "description": "Magento 2 module to add rate limiting to GraphQL resources",
  "keywords": [
    "composer-installer",
    "magento"
  ],
  "authors": [
    {
      "name": "Jisse Reitsma (Yireo)",
      "email": "jisse@yireo.com"
    }
  ],
  "require": {
    "magento/framework": "^100.1|^101.0|^102.0|^103.0",
    "magento/module-backend": "^101.0|^102.0",
    "magento/module-config": "^101.1|^101.2",
    "magento/module-graph-ql": "^100.3|^100.4",
    "php": ">=7.4 <8.6",
    "webonyx/graphql-php": "^0.13|^14.0|^15.0"
  },
  "require-dev": {
    "ext-json": "*",
    "phpunit/phpunit": "^9.5",
    "yireo/magento2-integration-test-helper": "@dev"
  },
  "autoload": {
    "psr-4": {
      "Yireo\\GraphQlRateLimiting\\": ""
    },
    "files": [
      "registration.php"
    ]
  }
}
