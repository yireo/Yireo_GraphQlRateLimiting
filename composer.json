{
    "name": "yireo/magento2-graph-ql-rate-limiting",
    "license": "OSL-3.0",
    "type": "magento2-module",
    "version": "0.0.5",
    "homepage": "https://github.com/yireo/Yireo_GraphQlRateLimiting",
    "description": "Magento 2 module to add rate limiting to GraphQL resources",
    "keywords": [
        "composer-installer",
        "magento"
    ],
    "require": {
        "magento/framework": "^100.1|^101.0|^102.0|^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "php": ">=8.2 <8.6",
        "webonyx/graphql-php": "^15.0"
    },
    "require-dev": {
        "ext-json": "*",
        "magento/module-graph-ql": "^100.4",
        "phpunit/phpunit": "^10.5",
        "yireo/magento2-integration-test-helper": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\GraphQlRateLimiting\\": ""
        },
        "files": [
            "registration.php"
        ]
    }
}